{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savetheplate.tn/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "997063419161-msv9uo3bshk8882t1qjmd5a9jojqof7c.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "997063419161-7h5dmmlljrniqqki48ju54eq31bud2p3.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "997063419161-6pg7v8ueuv4u5ar3tkrb76um6r4e5376.apps.googleusercontent.com",
        "EXPO_PUBLIC_FACEBOOK_APP_ID": "2359090251275497"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savetheplate.tn/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "997063419161-msv9uo3bshk8882t1qjmd5a9jojqof7c.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "997063419161-7h5dmmlljrniqqki48ju54eq31bud2p3.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "997063419161-6pg7v8ueuv4u5ar3tkrb76um6r4e5376.apps.googleusercontent.com",
        "EXPO_PUBLIC_FACEBOOK_APP_ID": "2359090251275497"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://savetheplate.tn/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "997063419161-msv9uo3bshk8882t1qjmd5a9jojqof7c.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "997063419161-7h5dmmlljrniqqki48ju54eq31bud2p3.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "997063419161-6pg7v8ueuv4u5ar3tkrb76um6r4e5376.apps.googleusercontent.com",
        "EXPO_PUBLIC_FACEBOOK_APP_ID": "2359090251275497"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your-apple-id@email.com",
        "ascAppId": "replace-with-app-store-connect-app-id",
        "appleTeamId": "replace-with-apple-team-id"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
