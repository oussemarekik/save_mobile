{
  "expo": {
    "name": "Save The Plate",
    "slug": "savetheplate",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "savetheplate",
      "tn.savetheplate.app",
      "fb2359090251275497"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "tn.savetheplate.app",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Save The Plate needs camera access to scan pickup QR codes.",
        "NSPhotoLibraryUsageDescription": "Save The Plate needs photo library access to upload food offer images.",
        "NSLocationWhenInUseUsageDescription": "Save The Plate uses your location to show nearby food offers.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "tn.savetheplate.app",
      "versionCode": 9,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "tn.savetheplate.app", "pathPrefix": "/oauthredirect" },
            { "scheme": "savetheplate" },
            { "scheme": "fb2359090251275497" }
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Save The Plate to access your camera to scan pickup QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Save The Plate uses your location to show nearby food offers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Save The Plate to access your photos to upload food offer images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#059669",
          "defaultChannel": "default"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "sarrasou",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d59bdf7c-c768-4b25-9c98-a6abafae5574"
      }
    }
  }
}
