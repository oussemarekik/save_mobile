{
  "expo": {
    "name": "Save The Plate",
    "slug": "savetheplate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "savetheplate",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "tn.savetheplate.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Save The Plate needs camera access to scan pickup QR codes.",
        "NSPhotoLibraryUsageDescription": "Save The Plate needs photo library access to upload food offer images.",
        "NSLocationWhenInUseUsageDescription": "Save The Plate uses your location to show nearby food offers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "tn.savetheplate.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Save The Plate to access your camera to scan pickup QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Save The Plate uses your location to show nearby food offers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Save The Plate to access your photos to upload food offer images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    },
    "owner": "savetheplate"
  }
}
