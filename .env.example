# SaveThePlate Mobile App Environment Variables
# Copy to .env and fill in values for local development

# Backend API (use localhost for local dev, production URL for builds)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Google OAuth (create iOS/Android OAuth clients in Google Cloud Console)
# Must also be set in eas.json build env (or EAS secrets) — local .env is NOT used by EAS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Facebook Login (same App ID as backend FACEBOOK_APP_ID)
# Add Valid OAuth Redirect URI in Meta: fb{APP_ID}://authorize
EXPO_PUBLIC_FACEBOOK_APP_ID=

# Google Maps (Places autocomplete for business location)
# Same key as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY on the website
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
