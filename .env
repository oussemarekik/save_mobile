# Database
# For local development, you can use:
# - Neon (https://neon.tech) - Free PostgreSQL database
# - Local PostgreSQL (postgresql://user:password@localhost:5432/foodsaver)
# - Supabase, Railway, or any PostgreSQL provider
DATABASE_URL="postgresql://savetheplate_user:local_dev_password@localhost:5432/savetheplate_local"

# Session Secret
# Generate a random string for session encryption
# You can generate one with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here-change-this-in-production

# Replit Auth (Optional - only needed if using Replit Auth)
# Leave these empty for local development without Replit Auth
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# NestJS Backend URL (for API calls)
# Default: http://localhost:3001
EXPO_PUBLIC_API_URL=http://192.168.176.1:3001
